{
  "name": "grep-finder",
  "displayName": "Grep Finder",
  "description": "Grep-style multi-file finder: control context lines like -A/-B/-C and open several matches side-by-side, each at its own match. Fully offline, no network access, uses the ripgrep already bundled with VS Code.",
  "version": "0.0.12",
  "publisher": "RobertoRiquelmeSaez",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rriquelme/Enhanced-Finder-VS-Code.git"
  },
  "bugs": {
    "url": "https://github.com/rriquelme/Enhanced-Finder-VS-Code/issues"
  },
  "homepage": "https://github.com/rriquelme/Enhanced-Finder-VS-Code#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Searching is read-only and runs in untrusted workspaces. For safety, a workspace-defined 'grepFinder.ripgrepPath' is ignored in untrusted workspaces; the editor's bundled ripgrep is used instead.",
      "restrictedConfigurations": [
        "grepFinder.ripgrepPath"
      ]
    }
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "search",
    "find",
    "grep",
    "ripgrep",
    "context",
    "offline",
    "privacy",
    "split editor",
    "side by side"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "grepFinder",
          "title": "Grep Finder",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "grepFinder": [
        {
          "id": "grepFinder.searchView",
          "type": "webview",
          "name": "Grep Finder"
        }
      ]
    },
    "commands": [
      {
        "command": "grepFinder.focus",
        "title": "Grep Finder: Focus Search"
      }
    ],
    "keybindings": [
      {
        "command": "grepFinder.focus",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      }
    ],
    "configuration": {
      "title": "Grep Finder",
      "properties": {
        "grepFinder.defaultContextLines": {
          "type": "number",
          "default": 2,
          "description": "Default number of context lines (both before and after) shown around each match."
        },
        "grepFinder.maxGridEditors": {
          "type": "number",
          "default": 9,
          "description": "Maximum number of editors opened at once when using 'Open in grid'."
        },
        "grepFinder.maxResults": {
          "type": "number",
          "default": 2000,
          "description": "Maximum number of matches to collect per search before truncating."
        },
        "grepFinder.ripgrepPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to a ripgrep (rg) binary. Leave empty to use the ripgrep that VS Code ships with (falling back to 'rg' on your PATH)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "gen-icon": "node scripts/gen-icon.js",
    "watch": "node esbuild.js --watch",
    "lint": "eslint src --ext ts",
    "test": "node --test --import tsx test/*.test.ts",
    "compile:integration": "tsc -p tsconfig.integration.json",
    "test:integration": "npm run build && npm run compile:integration && node out/test/integration/runTest.js",
    "package": "npm run build && vsce package --no-update-package-json"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/codicons": "^0.0.35",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^2.32.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "glob": "^10.5.0",
    "mocha": "^10.8.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {}
}
