{
  "name": "enhanced-finder",
  "displayName": "Enhanced Finder",
  "description": "Grep-style multi-file finder with context lines and grid open for VS Code.",
  "version": "0.0.5",
  "publisher": "enhanced-finder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rriquelme/enhanced-finder-vs-code.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "search",
    "find",
    "grep",
    "ripgrep",
    "context"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "enhancedFinder",
          "title": "Enhanced Finder",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "enhancedFinder": [
        {
          "id": "enhancedFinder.searchView",
          "type": "webview",
          "name": "Enhanced Finder"
        }
      ]
    },
    "commands": [
      {
        "command": "enhancedFinder.focus",
        "title": "Enhanced Finder: Focus Search"
      }
    ],
    "keybindings": [
      {
        "command": "enhancedFinder.focus",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      }
    ],
    "configuration": {
      "title": "Enhanced Finder",
      "properties": {
        "enhancedFinder.defaultContextLines": {
          "type": "number",
          "default": 2,
          "description": "Default number of context lines (both before and after) shown around each match."
        },
        "enhancedFinder.maxGridEditors": {
          "type": "number",
          "default": 9,
          "description": "Maximum number of editors opened at once when using 'Open in grid'."
        },
        "enhancedFinder.maxResults": {
          "type": "number",
          "default": 2000,
          "description": "Maximum number of matches to collect per search before truncating."
        },
        "enhancedFinder.useSmartCase": {
          "type": "boolean",
          "default": true,
          "description": "Use smart case (case-insensitive unless the query contains an uppercase letter)."
        },
        "enhancedFinder.ripgrepPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to a ripgrep (rg) binary. Leave empty to use the ripgrep that VS Code ships with (falling back to 'rg' on your PATH)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "lint": "eslint src --ext ts",
    "test": "node --test --import tsx test/*.test.ts",
    "compile:integration": "tsc -p tsconfig.integration.json",
    "test:integration": "npm run build && npm run compile:integration && node out/test/integration/runTest.js",
    "package": "npm run build && vsce package --no-update-package-json"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/codicons": "^0.0.35",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^2.32.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "glob": "^10.5.0",
    "mocha": "^10.8.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {}
}
